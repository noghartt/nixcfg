{
  "leader": {
    "models": ["anthropic-subscription/claude-opus-5-5", "anthropic/claude-opus-5-5"],
    "thinking": "xhigh"
  },
  "jev": {
    "model": "jev-latest",
    "baseUrl": "https://api.typesafe.ai",
    "strategyConfidence": 0.5,
    "modelConfidence": 0.5,
    "placementConfidence": 0.5,
    "envThreshold": 0.6,
    "acceptThreshold": 0.7,
    "blockedThreshold": 0.5,
    "borderlineFloor": 0.4
  },
  "fallbackWorker": "sonnet",
  "maxAttempts": 3,
  "maxWorkers": 6,
  "maxFixRounds": 2,
  "spillAt": 85,
  "workers": {
    "placement": "auto",
    "envAllowed": {
      "GH_TOKEN": "read-only GitHub API token for gh: issues, pull requests, and repository metadata; Git itself never needs it"
    },
    "allowOpenNet": false,
    "net": "dev",
    "size": "medium"
  },
  "consultant": {
    "models": ["anthropic-subscription/claude-fable-5-1", "anthropic/claude-fable-5-1", "chatgpt-subscription/gpt-6-astra", "openai-codex/gpt-6-astra"],
    "thinking": "high",
    "timeoutSeconds": 900,
    "tools": ["read", "grep", "find", "ls"]
  },
  "audit": { "minNodes": 4 },
  "pool": [
    {
      "key": "sonnet",
      "models": ["anthropic-subscription/claude-sonnet-5-5", "anthropic/claude-sonnet-5-5", "chatgpt-subscription/gpt-5.6-terra", "openai-codex/gpt-5.6-terra"],
      "spill": ["chatgpt-subscription/gpt-5.6-terra", "openai-codex/gpt-5.6-terra"],
      "thinking": "medium",
      "tier": 1,
      "use": "Easier, well-specified work: mechanical edits, tests, small bug fixes, and refactors inside one subsystem"
    },
    {
      "key": "opus",
      "models": ["anthropic-subscription/claude-opus-5-5", "anthropic/claude-opus-5-5", "chatgpt-subscription/gpt-6-sol", "openai-codex/gpt-6-sol"],
      "spill": ["chatgpt-subscription/gpt-6-sol", "openai-codex/gpt-6-sol"],
      "thinking": "medium",
      "tier": 2,
      "use": "Complex work: features across modules, cross-cutting changes, subtle debugging, performance work, and careful code review"
    },
    {
      "key": "fable",
      "models": ["anthropic-subscription/claude-fable-5-1", "anthropic/claude-fable-5-1"],
      "thinking": "high",
      "tier": 3,
      "onRequest": true,
      "use": "Orchestration-level planning, architecture, and design decisions with no existing pattern to copy"
    },
    {
      "key": "gpt-astra",
      "models": ["chatgpt-subscription/gpt-6-astra", "openai-codex/gpt-6-astra"],
      "thinking": "high",
      "tier": 3,
      "onRequest": true,
      "use": "The hardest reasoning: invariants, concurrency, and correctness arguments"
    }
  ]
}
